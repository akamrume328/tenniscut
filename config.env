# テニス予約通知システム設定ファイル

# LINE Notify 設定
LINE_ACCESS_TOKEN=YOUR_LINE_NOTIFY_TOKEN_HERE
USE_MOCK_LINE=True

# 通知スケジュール設定
MORNING_NOTIFICATION_TIME=08:00
EVENING_NOTIFICATION_TIME=18:00

# 通知対象の設定
ENABLE_URGENT_NOTIFICATIONS=True
ENABLE_DAILY_NOTIFICATIONS=True

# データソース設定
DATA_SOURCE=sample  # sample, csv, database
CSV_FILE_PATH=reservations.csv
DATABASE_URL=sqlite:///reservations.db

# ログ設定
LOG_LEVEL=INFO
LOG_FILE=notifications.log